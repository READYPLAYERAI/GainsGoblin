<resources>
    <!-- Dark variant of AppTheme.NoActionBar: dark system bars with light icons. -->
    <style name="AppTheme.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:statusBarColor">@color/app_dark_surface</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/app_dark_surface</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
